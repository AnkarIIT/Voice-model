STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
ELEVENLABS_API_KEY=
WHISPER_MODEL=base
WHISPER_DEVICE=cuda

GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
USE_LOCAL_LLM=0

EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

MAX_UPLOAD_MB=25
MAX_K=20
DEFAULT_K=5
ABSTAIN_THRESHOLD=0.35
GROUNDING_HIT_RATE=0.4

CORS_ORIGINS=*
LOG_LEVEL=INFO
