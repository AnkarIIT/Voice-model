# ==== Voice RAG .env template =============================
# Copy to `.env` and fill in credentials.

# Required for real inference
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides
ELEVENLABS_STT_MODEL=scribe_v1
GROQ_MODEL=llama-3.1-8b-instant

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

DATA_DIR=data
INDEX_NAME=msmarco_hi_val_v1
INDEX_PARQUET=data/raw/hinval.parquet
INDEX_MAX_ROWS=1500
INDEX_EMBED_WORKERS=6
INDEX_SEED=42

# Retrieval
TOP_K=3
PARENT_SEARCH_TOP_K=3
CHILD_SEARCH_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.28
OFF_TOPIC_SCORE_THRESHOLD=0.20

# Grounding
GROUNDING_LEXICAL_THRESHOLD=0.10
GROUNDING_EMBEDDING_THRESHOLD=0.45

# Generation
MAX_ANSWER_TOKENS=96
LLM_TEMPERATURE=0.0
LLM_JSON_MODE=1

# Reliability
MAX_RETRIES=3
RETRY_BASE_DELAY_S=0.3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30
LLM_TIMEOUT_S=10
STT_TIMEOUT_S=20

# Benchmark / analytics
BENCHMARK_N_QUERIES=120

# Set 1 to run the whole stack without API keys (deterministic mock providers)
MOCK_MODE=0
